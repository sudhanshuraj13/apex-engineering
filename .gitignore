# Local Agent Mounting & Editor Configs (Prevent local machine path leaks)
.agents/
.cursor/

# Apex Runtime FSA State & Ephemeral Memory (Keep skill-registry.json tracked)
.apex/*
!.apex/skill-registry.json

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment & Secrets
.env
.env.*
!.env.example

# Node / Package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Artifacts
.DS_Store
Thumbs.db
desktop.ini